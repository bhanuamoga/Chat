# ---------------------------------------------------------------------------
# Database (used by Drizzle ORM)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ---------------------------------------------------------------------------
# Auth — NextAuth (Option A: the single session provider)
# ---------------------------------------------------------------------------
AUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# ---------------------------------------------------------------------------
# Google Gemini 2.5 Flash — powers the Natural Chat AI & Visual Analytics
# Get your API key from Google AI Studio: https://aistudio.google.com/
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Supabase — enables Realtime Broadcast, Storage and Auth user sync.
# Paste the values from your Supabase project:
#   Dashboard -> Project Settings -> API / Data API
#
#   Project URL   -> NEXT_PUBLIC_SUPABASE_URL   (e.g. https://abcdefgh.supabase.co)
#   anon public   -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#   service_role  -> SUPABASE_SERVICE_ROLE_KEY  (server only, never expose)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
